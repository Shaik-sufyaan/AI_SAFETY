# Copy this file to .env.local and fill it in. .env.local is gitignored.
# The key is read only on the server (Next.js API route) and by the CLI.
# It is never sent to the browser.
ANTHROPIC_API_KEY=

# Live runs from the website are OFF unless this is exactly "true".
# The CLI (npm run eval) does not need it.
ENABLE_LIVE_RUNS=false

# Only for a hosted deployment (e.g. Vercel) that should accept live runs.
# Both are required; the run form then asks for the password.
# Use a long random password (at least 12 characters).
LIVE_RUNS_ALLOW_REMOTE=false
LIVE_RUN_PASSWORD=
